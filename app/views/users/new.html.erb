<form action="/users" method="post" accept-charset="UTF-8" > 
  <label for="username"> Username:  </label>
  <input type="text" placeholder="username" id="username" name="user[username]"> <br>
  
  <label for="email"> Email:  </label>
  <input type="email" placeholder="email" id="email" name="user[email]"> <br>

  <label for="password"> Password:  </label>
  <input type="password" placeholder="password" id="password" name="user[password]">

  <input type="submit" value="submit">

</form>